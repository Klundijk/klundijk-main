# Klundijk: Apache-instellingen voor de statische build (hosting FXW / DirectAdman).
# Gebruik: kopieer dit bestand naar de webroot (public_html) als ".htaccess", naast de inhoud van dist/.
# Dit bestand is niet getest op de echte host: controleer na de eerste deploy /werk, /werk/ en een onbekende URL.
# Vereist mod_rewrite, mod_headers, mod_expires en mod_deflate (staan standaard aan op DirectAdmin).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# De site gebruikt URL's zonder slash op het eind (/werk) en mappen met een index.html.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Altijd HTTPS (achter een proxy of load balancer geldt X-Forwarded-Proto).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /werk/ wordt /werk (behalve de root).
  RewriteRule ^(.+)/$ /$1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Past aan zodra het formulier-endpoint bekend is (connect-src en form-action).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:; form-action 'self' https:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"

  # Bestanden met hash in de naam en de lettertypen mogen een jaar in de cache.
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/work/#">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
