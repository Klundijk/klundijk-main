# Klundijk: Apache-instellingen voor de statische build (hosting FXW / DirectAdman).
# Gebruik: kopieer dit bestand naar de webroot (public_html) als ".htaccess", naast de inhoud van dist/.
# Gevonden op de testomgeving bij FXW: zonder de regel voor index.html gaf /werk een 403. Controleer na elke deploy /werk, /werk/ en een onbekende URL.
# Vereist mod_rewrite, mod_headers, mod_expires en mod_deflate (staan standaard aan op DirectAdmin).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# De site gebruikt URL's zonder slash op het eind (/werk) en mappen met een index.html.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Altijd HTTPS (achter een proxy of load balancer geldt X-Forwarded-Proto).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirects zijn absoluut op basis van de aangevraagde host, zodat ze nooit naar een ander domein (zoals het testsubdomein) wijzen.
  # Oude Webflow-adressen van klundijk.com naar de nieuwe pagina's (301, zodat zoekmachines en bestaande links meeverhuizen).
  # Controleer bij livegang met de lijst in Notion 04 of er nog adressen bij moeten komen.
  RewriteRule ^projecten/?$ https://%{HTTP_HOST}/werk [R=301,L]
  RewriteRule ^projecten/kraaijav/?$ https://%{HTTP_HOST}/werk/kraaij-av [R=301,L]
  RewriteRule ^projecten/auto-restyle-noord/?$ https://%{HTTP_HOST}/werk/auto-restyle-noord [R=301,L]
  RewriteRule ^branding/?$ https://%{HTTP_HOST}/wat-we-doen/merk-identiteit [R=301,L]
  RewriteRule ^website/?$ https://%{HTTP_HOST}/wat-we-doen/websites-digitale-ervaringen [R=301,L]
  RewriteRule ^webshops/?$ https://%{HTTP_HOST}/wat-we-doen/webshops-commerce [R=301,L]
  RewriteRule ^klundijk/?$ https://%{HTTP_HOST}/over [R=301,L]
  RewriteRule ^blog/?$ https://%{HTTP_HOST}/werk [R=301,L]

  # /werk/ wordt /werk (behalve de root).
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [L,R=301]

  # Met DirectorySlash Off serveert Apache bij /werk niet vanzelf werk/index.html (dat geeft 403).
  # Daarom intern doorsturen naar de index.html in die map.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Het formulier post alleen naar /api/contact.php op dezelfde site ('self'). Komt er een externe dienst bij (bijv. Cloudflare Turnstile), dan moet die hier expliciet bij.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"

  # Beheerpagina van het CMS (/admin): mag verbinden met GitHub (inloggen en opslaan), blijft verder dicht en uit zoekmachines.
  <If "%{REQUEST_URI} =~ m#^/admin#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https://*.githubusercontent.com; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' data: https://api.github.com https://github.com https://*.githubusercontent.com https://unpkg.com https://www.githubstatus.com https://cdn.jsdelivr.net; worker-src 'self' blob:; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  # Bestanden met hash in de naam en de lettertypen mogen een jaar in de cache.
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/work/#">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
