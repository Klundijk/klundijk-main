---
import { STEPS } from '../../data/home';
---
<section class="section" aria-labelledby="pr-h">
  <p class="mono">Van advies tot regie</p>
  <h2 id="pr-h" class="h2">Eerst begrijpen. Dan pas maken of regisseren.</h2>
  <ol class="steps">
    {STEPS.map((s, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><strong>{s}</strong></li>)}
  </ol>
</section>
<style>
  .h2 { font-size: var(--t-display); font-weight: 800; font-stretch: 115%; line-height: 1; letter-spacing: -.03em; margin: .5rem 0 2rem; max-width: 20ch; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); counter-reset: s; }
  .steps li { border-top: 2px solid var(--k-ink); padding-top: .75rem; display: grid; gap: .25rem; }
  .steps strong { font-size: var(--t-card); font-stretch: 110%; }
</style>
