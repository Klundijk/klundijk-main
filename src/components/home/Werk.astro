---
// Werk (bord X · Home): accordeon met alle projecten, het eerste staat open. Zonder JavaScript staan alle panelen open.
// Open en dicht animeren (hoogte via grid-rows, inhoud fade); bij verminderde beweging zonder animatie.
import { dims, srcsetFor } from '../../lib/images';
import { getWorkItems, hasCasePage, textOn } from '../../lib/content';
import { showPlaceholders } from '../../data/site';
import { HOME_TEXT as t } from '../../data/home';
const items = await getWorkItems();
const rows = items.map((e, i) => ({
  id: e.id, n: String(i + 1).padStart(2, '0'), c: e.data, linked: hasCasePage(e), fg: textOn(e.data.cardColor),
  srcset: e.data.cardImage ? srcsetFor(e.data.cardImage.src) : undefined,
  thumb: e.data.cardImage?.src.endsWith('.webp') ? e.data.cardImage.src.replace('.webp', '-800.webp') : e.data.cardImage?.src,
  accent: e.data.tags.includes('Webshop'),
}));
---
<section class="werk" id="werk" aria-labelledby="werk-h">
  <div class="werk__head">
    <h2 id="werk-h" class="werk__h">{t.werk.title}</h2>
    <p class="mono werk__hint">{t.werk.hint}</p>
  </div>
  <ul class="wlist" data-wlist>
    {rows.map((r, i) => (
      <li class="wrow" data-wrow>
        <h3 class="wrow__h">
          <button type="button" class="wrow__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`wp-${r.id}`} data-wtoggle>
            <span class="wrow__n mono" aria-hidden="true">{r.n}</span>
            <span class="wrow__name">{r.c.title}</span>
            <span class="wrow__tags"><span class:list={['wpill mono', { 'wpill--accent': r.accent }]}>{r.c.tags.join(' · ')}</span></span>
            <span class="wrow__thumbs" aria-hidden="true">
              {r.thumb
                ? <><img src={r.thumb} alt="" width="64" height="48" loading="lazy" decoding="async" style="object-position:30% 50%" /><img src={r.thumb} alt="" width="64" height="48" loading="lazy" decoding="async" style="object-position:75% 50%" /></>
                : <><span class="wrow__thumbph"></span><span class="wrow__thumbph"></span></>}
            </span>
            <span class="wrow__ico" aria-hidden="true"></span>
          </button>
        </h3>
        <div class="wpanel" id={`wp-${r.id}`} data-open={i === 0 ? '' : undefined} data-wpanel>
          <div class="wpanel__in"><div class="wcard" style={`--bg:${r.c.cardColor};--fg:${r.fg}`}>
            <div class="wcard__media">
              {r.c.soon && <span class="wcard__pill mono">Binnenkort</span>}
              {r.c.soon && !r.c.cardImage
                ? (r.c.logo
                    ? <img class="wcard__logo" src={r.c.logo.src} alt={r.c.logo.alt || r.c.title} loading="lazy" decoding="async" />
                    : <span class="wcard__brand" aria-hidden="true">{r.c.title}</span>)
                : r.c.cardImage
                ? <img src={r.c.cardImage.src} srcset={r.srcset} sizes="(min-width: 1100px) 66vw, 100vw" alt={r.c.cardImage.alt} width={dims(r.c.cardImage.src).width} height={dims(r.c.cardImage.src).height} loading="lazy" decoding="async" style={r.c.cardImage.position ? `object-position:${r.c.cardImage.position}` : undefined} />
                : showPlaceholders && <span class="wcard__ph mono">Beeld — [nog te leveren]</span>}
            </div>
            <div class="wcard__body">
              <p class="mono wcard__tags">{r.c.tags.join(' · ')}</p>
              <p class="wcard__line">{r.c.excerpt ?? r.c.promise}</p>
              {r.linked
                ? <a class="wcard__cta" href={`/werk/${r.id}`}>Bekijk case<span class="sr-only"> {r.c.title}</span></a>
                : !r.c.soon && <span class="wcard__cta wcard__cta--soon">Case volgt</span>}
            </div>
          </div></div>
        </div>
      </li>
    ))}
  </ul>
</section>
<script>
  const rows = [...document.querySelectorAll<HTMLElement>('[data-wrow]')];
  const set = (row: HTMLElement, open: boolean) => {
    row.querySelector('[data-wtoggle]')?.setAttribute('aria-expanded', String(open));
    const panel = row.querySelector<HTMLElement>('[data-wpanel]')!;
    if (open) panel.setAttribute('data-open', ''); else panel.removeAttribute('data-open');
  };
  rows.forEach((row) => {
    row.querySelector('[data-wtoggle]')?.addEventListener('click', () => {
      const open = row.querySelector('[data-wtoggle]')?.getAttribute('aria-expanded') === 'true';
      rows.forEach((r) => set(r, r === row ? !open : false));
    });
  });
</script>
<style>
  .werk { padding: 3.5rem var(--pad-x) 2.5rem; display: flex; flex-direction: column; gap: clamp(1.5rem, 2.8vw, 2.5rem); }
  @media (min-width: 768px) { .werk { padding-top: var(--pad-y); padding-bottom: 4.5rem; } }
  .werk__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; }
  .werk__h { max-width: 56rem; font-weight: 800; font-stretch: 112%; font-size: var(--t-display); line-height: 1.06; letter-spacing: -0.04em; margin: 0; }
  @media (min-width: 768px) { .werk__h { font-stretch: 112%; line-height: 0.98; } }
  .werk__hint { display: none; color: var(--k-muted); margin: 0; }
  @media (min-width: 768px) { .werk__hint { display: block; } }

  .wlist { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--k-ink); }
  .wrow { border-top: 1px solid var(--k-ink); }
  .wrow__h { margin: 0; font: inherit; }
  .wrow__btn { width: 100%; text-align: left; background: none; border: 0; cursor: pointer; color: var(--k-ink); padding: 1.25rem 0;
    display: grid; grid-template-columns: 1fr auto; gap: 0.625rem 0.75rem; align-items: baseline; }
  .wrow__n, .wrow__thumbs { display: none; }
  .wrow__name { font-weight: 800; font-stretch: 112%; font-size: var(--t-row); letter-spacing: -0.03em; line-height: 1.05; }
  /* Plus gebouwd uit twee balkjes: draait 45° naar een kruis als de rij openstaat. */
  .wrow__ico { grid-row: 1; grid-column: 2; position: relative; width: 1.5rem; height: 1.5rem; justify-self: end; align-self: center; transition: transform 0.4s var(--ease); }
  .wrow__ico::before, .wrow__ico::after { content: ''; position: absolute; left: 50%; top: 50%; width: 100%; height: 2px; background: currentColor; transform: translate(-50%, -50%); }
  .wrow__ico::after { transform: translate(-50%, -50%) rotate(90deg); }
  .wrow__btn[aria-expanded='true'] .wrow__ico { transform: rotate(45deg); }
  .wrow__tags { grid-column: 1 / -1; display: flex; }
  .wpill { border: 1px solid var(--k-ink); border-radius: 999px; padding: 0.375rem 0.75rem; font-size: var(--t-mono); letter-spacing: 0.04em; background: transparent; }
  .wpill--accent { background: var(--k-accent); }
  .wrow__name { transition: transform 0.35s var(--ease); }
  .wrow__btn:hover .wrow__name { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; transform: translateX(10px); }
  .wrow__thumbs img, .wrow__thumbph { transition: transform 0.35s var(--ease); }
  .wrow__btn:hover .wrow__thumbs img:first-child, .wrow__btn:hover .wrow__thumbph:first-child { transform: rotate(-4deg) translateY(-2px); }
  .wrow__btn:hover .wrow__thumbs img:last-child, .wrow__btn:hover .wrow__thumbph:last-child { transform: rotate(4deg) translateY(-2px); }

  /* Open/dicht: de rij groeit van 0fr naar 1fr; dicht = onzichtbaar en niet focusseerbaar (visibility wacht tot de animatie klaar is). */
  .wpanel { display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows 0.5s var(--ease), visibility 0s linear 0.5s; }
  .wpanel[data-open] { grid-template-rows: 1fr; visibility: visible; transition: grid-template-rows 0.5s var(--ease), visibility 0s; }
  .wpanel__in { min-height: 0; overflow: hidden; padding-bottom: 0; }
  .wpanel__in > .wcard { margin-bottom: 1.5rem; opacity: 0; transform: translateY(14px); transition: opacity 0.35s ease, transform 0.5s var(--ease); }
  .wpanel[data-open] .wcard { opacity: 1; transform: none; transition-delay: 0.12s; }
  .wcard { border-radius: 24px; overflow: hidden; background: var(--bg); color: var(--fg); display: flex; flex-direction: column; }
  .wcard__media { position: relative; height: 14.375rem; overflow: hidden; order: -1; }
  .wcard__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .wcard__media .wcard__logo { position: absolute; inset: 0; margin: auto; width: auto; height: auto; max-width: 72%; max-height: 46%; object-fit: contain; }
  .wcard__brand { position: absolute; inset: 0; display: grid; place-items: center; padding: 2rem; text-align: center; font-weight: 800; font-stretch: 112%; font-size: var(--t-row); letter-spacing: -0.03em; line-height: 1.05; }
  .wcard__pill { position: absolute; right: 1rem; top: 1rem; z-index: 1; font-size: var(--t-mono); letter-spacing: 0.08em; text-transform: uppercase; padding: 0.25rem 0.75rem; border: 1px solid currentColor; border-radius: 999px; }
  .wcard__ph { position: absolute; inset: 0; padding: 0.75rem; display: flex; align-items: flex-end; border: 1px dashed currentColor; margin: 1rem; }
  .wcard__body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  .wcard__tags { display: none; margin: 0; letter-spacing: 0.08em; }
  .wcard__line { margin: 0; font-size: var(--t-small); line-height: 1.4; }
  .wcard__cta { display: inline-flex; align-items: center; min-height: 48px; padding: 0 1.375rem; border: 2px solid var(--fg); border-radius: 999px; color: var(--fg); font-size: var(--t-small); font-weight: 700; text-decoration: none; }
  .wcard__cta { transition: background-color 0.2s ease, color 0.2s ease, transform 0.25s var(--ease); }
  a.wcard__cta:hover { background: var(--fg); color: var(--bg); transform: translateX(3px); }
  .wcard__cta--soon { opacity: 0.85; }

  @media (min-width: 768px) {
    .wrow__btn { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: center; padding: 1.625rem 0; }
    .wrow__n { display: block; grid-column: span 1; font-size: var(--t-mono); letter-spacing: 0.08em; color: var(--k-muted); }
    .wrow__name { grid-column: span 6; font-stretch: 112%; line-height: 1; }
    .wrow__tags { grid-column: span 4; }
    .wpill { padding: 0.5rem 1rem; font-size: var(--t-mono); }
    .wrow__thumbs img, .wrow__thumbph { width: 64px; height: 48px; object-fit: cover; }
    .wrow__thumbph { border: 1px dashed var(--k-ink); background: #dad5cb; display: block; }
    .wrow__ico { grid-row: auto; grid-column: span 1; width: 1.75rem; height: 1.75rem; }
    .wpanel__in > .wcard { margin-bottom: 2rem; }
    .wcard { display: grid; grid-template-columns: 4fr 8fr; height: 33.75rem; border-radius: 28px; }
    .wcard__media { order: 0; height: auto; grid-column: 2; grid-row: 1; }
    .wcard__body { grid-column: 1; grid-row: 1; padding: 2rem; justify-content: space-between; gap: 1.5rem; }
    .wcard__tags { display: block; font-size: var(--t-mono); }
    .wcard__line { font-size: var(--t-lead); line-height: 1.35; }
    .wcard__cta { font-size: var(--t-small); padding: 0 1.5rem; }
  }
  @media (min-width: 1100px) {
    .wrow__name { grid-column: span 5; }
    .wrow__tags { grid-column: span 3; }
    .wrow__thumbs { display: flex; grid-column: span 2; gap: 0.5rem; justify-content: flex-end; }
  }
  @media (max-width: 1099px) and (min-width: 768px) { .wcard { height: 28rem; grid-template-columns: 1fr 1.6fr; } .wcard__line { font-size: var(--t-body); } }
  @media (prefers-reduced-motion: reduce) { .wrow__btn *, .wpanel, .wpanel__in > .wcard { transition: none !important; } }
</style>
