---
import { WORK } from '../../data/home';
---
<section class="section" aria-labelledby="werk-h">
  <h2 id="werk-h" class="h2">Werk dat iets in beweging zet.</h2>
  <ul class="rows">
    {WORK.map((w) => (
      <li>
        <a href={w.href} class="row">
          <span class="row__t">{w.title}</span>
          <span class="row__tags">{w.tags.map((t) => <span class:list={['tag', { 'tag--accent': t === 'Webshop' }]}>{t}</span>)}</span>
          <span class="row__go" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>
<style>
  .h2 { font-size: var(--t-display); font-weight: 800; font-stretch: 115%; line-height: 1; letter-spacing: -.03em; margin: 0 0 2rem; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--k-line); }
  .row { display: grid; grid-template-columns: 1fr auto; gap: .5rem 1rem; align-items: center; padding: 1.25rem 0; border-bottom: 1px solid var(--k-line); color: inherit; text-decoration: none; transition: padding .3s var(--ease); }
  .row:hover, .row:focus-visible { padding-left: 1rem; }
  .row__t { font-size: var(--t-row); font-weight: 800; font-stretch: 115%; letter-spacing: -.02em; }
  .row__tags { grid-column: 1; display: flex; flex-wrap: wrap; gap: .5rem; }
  .row__go { grid-row: 1; grid-column: 2; font-size: 1.5rem; }
  @media (min-width: 768px) { .row { grid-template-columns: 1.4fr 1.6fr auto; } .row__tags { grid-column: auto; } .row__go { grid-row: auto; grid-column: auto; } }
  .tag--accent { background: var(--k-accent); color: var(--k-ink); border-color: var(--k-accent); }
  @media (prefers-reduced-motion: reduce) { .row { transition: none; } }
</style>
