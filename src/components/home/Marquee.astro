---
const text = 'Digitaal kan beter. — Dus maken we het beter. — ';
---
<section class="marquee" aria-label="Motto">
  <div class="marquee__track" id="marquee-track" aria-hidden="true">
    <span>{text.repeat(6)}</span><span>{text.repeat(6)}</span>
  </div>
  <p class="sr-only">Digitaal kan beter. Dus maken we het beter.</p>
  <button type="button" class="marquee__btn mono" id="marquee-btn" aria-pressed="false">Pauzeer beweging</button>
</section>
<script>
  const track = document.getElementById('marquee-track');
  const b = document.getElementById('marquee-btn');
  b?.addEventListener('click', () => {
    const paused = track?.classList.toggle('is-paused');
    b.setAttribute('aria-pressed', String(!!paused));
    b.textContent = paused ? 'Hervat beweging' : 'Pauzeer beweging';
  });
</script>
<style>
  .marquee { background: var(--k-ink); color: var(--k-paper); overflow: hidden; position: relative; padding: 1.25rem 0; }
  .marquee__track { display: flex; width: max-content; animation: mq 40s linear infinite; font-family: var(--f-sans); font-weight: 800; font-stretch: 125%; font-size: var(--t-row); text-transform: uppercase; white-space: nowrap; }
  .marquee:hover .marquee__track, .marquee:focus-within .marquee__track, .marquee__track.is-paused { animation-play-state: paused; }
  .marquee__btn { position: absolute; right: var(--pad-x); bottom: .25rem; background: var(--k-paper); color: var(--k-ink); border: 0; border-radius: 999px; padding: .25rem .75rem; font-size: .7rem; cursor: pointer; }
  @keyframes mq { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } .marquee__btn { display: none; } }
</style>
