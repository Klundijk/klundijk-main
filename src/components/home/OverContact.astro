---
import { CLIENTS } from '../../data/home';
import { showPlaceholders } from '../../data/site';
---
<section class="section over" aria-labelledby="over-h">
  <div>
    <p class="mono">Kleine studio, direct contact</p>
    <h2 id="over-h" class="h2">Korte lijnen, zonder korte blik.</h2>
    <p><a class="link-strong" href="/over">Over Klundijk</a></p>
  </div>
  <div>
    <h3 class="mono">Klanten</h3>
    <ul class="clients">{CLIENTS.map((c) => <li>{c}</li>)}</ul>
    {showPlaceholders && <p class="placeholder-flag">[Portret en quote nog aan te leveren.]</p>}
  </div>
</section>
<style>
  .over { display: grid; gap: 2rem; }
  @media (min-width: 1100px) { .over { grid-template-columns: 1fr 1fr; } }
  .h2 { font-size: var(--t-display); font-weight: 800; font-stretch: 115%; line-height: 1; letter-spacing: -.03em; margin: .5rem 0 1rem; }
  .clients { list-style: none; padding: 0; margin: .5rem 0 0; font-size: var(--t-lead); display: grid; gap: .25rem; }
</style>
