---
import { site } from '../../data/site';
---
<section class="hero on-field" aria-labelledby="hero-title">
  <div class="hero__inner">
    <p class="mono hero__eyebrow">Klundijk — digitale partner</p>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__l">Digitaal</span> <span class="hero__l">kan</span> <span class="hero__l hero__beter">beter.</span>
    </h1>
    <div class="hero__rough" aria-hidden="true">
      <span class="r1">Digitaal</span><span class="r2">kan</span><span class="r3">beter.</span>
      <span class="note n1">← 5 lettertypen</span><span class="note n2">geen hiërarchie →</span><span class="note n3">wat moet ik hier doen?</span>
    </div>
    <p class="hero__sub">Dus maken we het beter.</p>
    <p class="hero__text">Klundijk helpt bedrijven vooruit met sterke merken, websites, webshops en slimme digitale oplossingen. We beginnen bij het vraagstuk, niet bij het platform.</p>
    <p class="hero__actions">
      <a class="link-strong" href={site.secondaryCta.href}>{site.secondaryCta.label}</a>
      <a class="btn btn--primary btn--lg hero__cta" href={site.primaryCta.href}>{site.primaryCta.label}</a>
    </p>
    <button type="button" class="hero__toggle mono" id="hero-toggle" aria-pressed="false">Zie hoe het was</button>
  </div>
  <a class="hero__card" href="/werk">
    <span class="hero__img" role="img" aria-label="Beeld Auto Restyle Noord (volgt)"></span>
    <span class="hero__cardtxt"><span class="mono">Uitgelicht werk</span><strong>Auto Restyle Noord</strong>Nieuwe naam, nieuwe locatie: de online uitstraling opnieuw op orde.</span>
  </a>
</section>
<script>
  const root = document.documentElement;
  const btn = document.getElementById('hero-toggle');
  const sync = () => {
    const rough = root.dataset.intro === 'rough';
    btn?.setAttribute('aria-pressed', String(rough));
    if (btn) btn.textContent = rough ? 'Maak het beter' : 'Zie hoe het was';
  };
  sync();
  btn?.addEventListener('click', () => {
    root.dataset.intro = root.dataset.intro === 'rough' ? 'refined' : 'rough';
    sync();
  });
  // Eerste bezoek: 900 ms ruw, dan verfijnd (head-script zet data-intro="rough").
  if (root.dataset.intro === 'rough' && root.dataset.introAuto === '1') {
    setTimeout(() => { root.dataset.intro = 'refined'; sync(); }, 900);
  }
</script>
<style>
  .hero { background: var(--hero-bg); color: var(--hero-fg);
    transition: background .9s var(--ease), color .9s var(--ease); min-height: 46rem; padding: 8rem var(--pad-x) var(--pad-y);
    display: grid; gap: 2rem; grid-template-columns: 1fr; position: relative; overflow: clip; }
  @media (min-width: 1100px) { .hero { grid-template-columns: 1.6fr 1fr; align-items: end; } }
  .hero__eyebrow { text-transform: uppercase; font-size: var(--t-mono); }
  .hero__title { font-family: var(--f-sans); font-weight: 800; font-stretch: 125%; font-size: var(--t-hero);
    line-height: .92; letter-spacing: -.045em; margin: 1rem 0; }
  .hero__l { display: inline-block; }
  .hero__beter { font-family: var(--f-serif); font-style: italic; font-weight: 400; font-stretch: 100%; font-size: var(--t-hero-serif); color: var(--k-accent-text); letter-spacing: 0; }
  :global(:root) { --hero-bg: var(--k-field); --hero-fg: var(--k-on-field); }
  .hero__rough { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .9s var(--ease); font-family: Arial, sans-serif; color: #111; }
  .hero__rough .r1 { position: absolute; left: 6%; top: 24%; font-size: clamp(2.5rem, 8.9vw, 8rem); font-weight: 300; font-stretch: 62%; transform: rotate(-3deg); }
  .hero__rough .r2 { position: absolute; left: 12%; top: 44%; font-size: clamp(2rem, 6vw, 5.5rem); font-weight: 900; color: #C0392B; }
  .hero__rough .r3 { position: absolute; left: 8%; top: 60%; font-size: clamp(2.2rem, 7.5vw, 9rem); font-family: 'Times New Roman', serif; color: #1B6EC2; }
  .note { position: absolute; font-size: .8rem; color: #C0392B; }
  .n1 { left: 40%; top: 28%; } .n2 { left: 52%; top: 48%; } .n3 { left: 50%; top: 66%; }
  .hero__sub { font-size: clamp(1.5rem, 3.05vw, 2.75rem); font-weight: 500; font-stretch: 112%; margin: 0; transition: opacity .9s var(--ease); }
  .hero__text { max-width: 38rem; font-size: var(--t-body); transition: opacity .9s var(--ease); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; }
  .hero__toggle { min-height: 44px; background: none; border: 1px solid currentColor; color: inherit; border-radius: 999px; padding: .5rem 1rem; cursor: pointer; text-transform: uppercase; font-size: .8rem; }
  .hero__card { position: relative; display: block; border-radius: 24px; overflow: hidden; min-height: 22.5rem; background: color-mix(in srgb, var(--k-ink) 80%, var(--k-field)); color: #fff; text-decoration: none; transition: filter .9s var(--ease); }
  .hero__img { position: absolute; inset: 0; background: repeating-linear-gradient(135deg, #ffffff14 0 12px, #ffffff05 12px 24px); }
  .hero__cardtxt { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; background: var(--k-paper); color: var(--k-ink); border-radius: 16px; padding: 1rem; display: grid; gap: .25rem; font-size: .9rem; }
  /* Ruwe staat */
  :global(html[data-intro="rough"]) { --hero-bg: #E4E4E4; --hero-fg: #111; --hero-pill-bg: transparent; --hero-pill-fg: #1B6EC2; --hero-radius: 0; }
  :global(html[data-intro="rough"]) .hero__title { opacity: 0; }
  :global(html[data-intro="rough"]) .hero__rough { opacity: 1; }
  :global(html[data-intro="rough"]) .hero__sub { opacity: .25; }
  :global(html[data-intro="rough"]) .hero__cta { background: transparent; color: #1B6EC2; border-color: transparent; text-decoration: underline; }
  :global(html[data-intro="rough"]) .hero__card { filter: grayscale(1) blur(2px); }
  @media (prefers-reduced-motion: reduce) { .hero, .hero__rough, .hero__sub, .hero__text, .hero__card { transition: none; } }
</style>
