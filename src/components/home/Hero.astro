---
// Hero (bord X · Home / X · Mobiel). Twee lagen: de "ruwe" staat (hoe het was) en de verfijnde staat. De intro speelt alleen
// bij het eerste bezoek per sessie en nooit bij verminderde beweging; de knop wisselt altijd. Alleen opacity, transform
// en kleur worden geanimeerd, dus geen layoutverschuiving.
import { getWorkItems, hasCasePage } from '../../lib/content';
const entry = (await getWorkItems()).find((e) => e.id === 'auto-restyle-noord');
const c = entry?.data;
const img = c?.cardImage;
const srcset = img?.src.endsWith('.webp') ? `${img.src.replace('.webp', '-800.webp')} 800w, ${img.src} 1400w` : undefined;
const cardHref = entry && hasCasePage(entry) ? `/werk/${entry.id}` : '/werk';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__top">
    <p class="mono hero__eyebrow">Klundijk — digitale partner</p>
    <div class="hero__stage">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__l">Digitaal</span><span class="hero__l">kan</span><span class="hero__l hero__beter">beter.</span>
      </h1>
      <div class="hero__rough" aria-hidden="true">
        <span class="r1">Digitaal</span><span class="r2">kan</span><span class="r3">beter.</span>
      </div>
    </div>
    <div class="hero__notes" aria-hidden="true">
      <span class="note n1">← 5 lettertypen</span><span class="note n2">geen hiërarchie →</span><span class="note n3">wat moet ik hier doen?</span>
    </div>
  </div>

  <div class="hero__row">
    <div class="hero__copy">
      <p class="hero__sub">Dus maken we het beter.</p>
      <p class="hero__text">Klundijk helpt bedrijven vooruit met sterke merken, websites, webshops en slimme digitale oplossingen. We beginnen bij het vraagstuk, niet bij het platform.</p>
    </div>
    <div class="hero__ctas">
      <p class="hero__actions">
        <a class="link-strong hero__more" href="#werk">Bekijk ons werk</a>
        <a class="btn btn--primary btn--lg hero__cta" href="#contact">Bespreek je vraagstuk</a>
      </p>
      <button type="button" class="hero__toggle mono" id="hero-toggle" aria-pressed="false">Zie hoe het was</button>
    </div>
  </div>

  {c && (
    <a class="hero__card" href={cardHref}>
      {img
        ? <img class="hero__img" src={img.src} srcset={srcset} sizes="(min-width: 1500px) 1312px, calc(100vw - 2.5rem)" width="1400" height="875" alt={img.alt} fetchpriority="high" decoding="async" style={img.position ? `object-position:${img.position}` : undefined} />
        : <span class="hero__img hero__img--ph" aria-hidden="true"></span>}
      <span class="hero__cardtxt">
        <span class="mono">Uitgelicht werk</span>
        <strong>{c.title}</strong>
        <span class="hero__cardline">{c.excerpt ?? c.promise}</span>
      </span>
    </a>
  )}
</section>
<script>
  const root = document.documentElement;
  const btn = document.getElementById('hero-toggle');
  const sync = () => {
    const rough = root.dataset.intro === 'rough';
    btn?.setAttribute('aria-pressed', String(rough));
    if (btn) btn.textContent = rough ? 'Maak het beter' : 'Zie hoe het was';
  };
  sync();
  btn?.addEventListener('click', () => {
    root.dataset.intro = root.dataset.intro === 'rough' ? 'refined' : 'rough';
    sync();
  });
  // Eerste bezoek: 900 ms ruw, dan verfijnd (het head-script op de homepage zet data-intro="rough").
  if (root.dataset.intro === 'rough' && root.dataset.introAuto === '1') {
    setTimeout(() => { root.dataset.intro = 'refined'; sync(); }, 900);
  }
</script>
<style>
  :global(:root) { --hero-bg: var(--k-field); --hero-fg: var(--k-on-field); --hero-muted: color-mix(in srgb, var(--k-on-field) 78%, transparent); }
  .hero { background: var(--hero-bg); color: var(--hero-fg); transition: background 0.9s ease, color 0.9s ease;
    padding: clamp(6.5rem, 10.3vw, 9.25rem) var(--pad-x) clamp(3rem, 6.1vw, 5.5rem);
    display: flex; flex-direction: column; gap: clamp(2rem, 3.34vw, 3rem); overflow: clip; }

  .hero__top { position: relative; display: flex; flex-direction: column; gap: clamp(1.5rem, 2.2vw, 2rem); min-height: clamp(12.5rem, 27.8vw, 25rem); }
  .hero__eyebrow { color: var(--hero-muted); letter-spacing: 0.08em; font-size: clamp(0.75rem, 0.97vw, 0.875rem); transition: color 0.9s ease; }
  .hero__stage { position: relative; }
  .hero__title { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: clamp(1rem, 2.2vw, 2rem); font-weight: 800; font-stretch: 125%;
    font-size: var(--t-hero); line-height: 0.93; letter-spacing: -0.045em; margin: 0;
    transition: opacity 0.5s ease, transform 0.7s var(--ease); }
  .hero__l { display: inline-block; }
  .hero__beter { font-family: var(--f-serif); font-style: italic; font-weight: 400; font-stretch: 100%; font-size: var(--t-hero-serif); color: var(--k-accent-text); letter-spacing: -0.045em; }

  /* Ruwe laag: vijf lettertypen, geen hiërarchie. */
  .hero__rough { position: absolute; top: clamp(1.25rem, 4.2vw, 3.75rem); left: 0; right: 0; pointer-events: none; opacity: 0; transition: opacity 0.5s ease;
    display: flex; flex-wrap: wrap; align-items: baseline; column-gap: clamp(1rem, 2.2vw, 2rem); line-height: 0.93; letter-spacing: 0.05em; }
  .hero__rough span { display: inline-block; }
  .hero__rough .r1 { font-weight: 300; font-stretch: 62%; font-size: calc(var(--t-hero) * 0.86); color: #111; transform: translate(-8px, 18px) rotate(-3deg); }
  .hero__rough .r2 { font-weight: 900; font-stretch: 125%; font-size: calc(var(--t-hero) * 0.59); color: #c0392b; transform: translate(14px, -22px) rotate(4deg); }
  .hero__rough .r3 { font-family: 'Times New Roman', Times, serif; font-size: calc(var(--t-hero) * 0.99); color: #1b6ec2; transform: translate(-4px, 30px) rotate(-2deg); letter-spacing: 0.05em; }
  .note { position: absolute; font-family: var(--f-mono); font-size: 0.75rem; background: #c0392b; color: #fff; padding: 5px 8px; opacity: 0; transition: opacity 0.6s; white-space: nowrap; }
  .n1 { left: 0; top: calc(var(--t-hero) * 2.3); }
  .n2 { display: none; }
  .n3 { left: 38%; top: calc(var(--t-hero) * 3.85); }
  @media (min-width: 1100px) {
    .note { font-size: 0.8125rem; padding: 6px 10px; }
    .n1 { left: 9.15%; top: calc(var(--t-hero) * 1.01); }
    .n2 { display: block; left: 42.7%; top: calc(var(--t-hero) * 0.65); }
    .n3 { left: 62.5%; top: calc(var(--t-hero) * 1.69); }
  }

  .hero__row { display: grid; gap: 1.5rem; }
  .hero__copy { display: flex; flex-direction: column; gap: 1.5rem; }
  .hero__sub { font-size: clamp(1.75rem, 3.05vw, 2.75rem); font-weight: 500; font-stretch: 112%; line-height: 1.05; letter-spacing: -0.02em; margin: 0;
    transition: opacity 0.9s ease 0.3s, transform 0.9s ease 0.3s; }
  .hero__text { max-width: 35rem; font-size: clamp(1.125rem, 1.4vw, 1.25rem); line-height: 1.5; color: var(--hero-muted); margin: 0; transition: color 0.9s ease; }
  .hero__ctas { display: flex; flex-direction: column; gap: 0.5rem; }
  .hero__actions { display: flex; flex-direction: column-reverse; gap: 0.5rem; margin: 0; }
  .hero__actions .btn { min-height: 56px; width: 100%; }
  .hero__more { justify-content: center; min-height: 48px; }
  .hero__toggle { min-height: 48px; background: none; border: 0; color: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 5px;
    text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.06em; }
  @media (min-width: 768px) {
    .hero__actions { flex-direction: row; align-items: center; gap: 1.75rem; }
    .hero__actions .btn { width: auto; }
    .hero__more { justify-content: flex-start; }
    .hero__toggle { align-self: flex-start; font-size: 0.8125rem; }
  }
  @media (min-width: 1100px) {
    .hero__row { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: end; }
    .hero__copy { grid-column: span 6; }
    .hero__ctas { grid-column: 8 / span 5; align-items: flex-end; gap: 0.75rem; }
    .hero__actions .btn { padding: 0 1.875rem; }
    .hero__toggle { align-self: flex-end; }
  }

  .hero__card { position: relative; display: block; overflow: hidden; height: clamp(20rem, 25vw, 22.5rem); border-radius: 24px; background: #d2d2d2; color: var(--k-paper); text-decoration: none; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: filter 0.9s ease; }
  .hero__img--ph { background: repeating-linear-gradient(135deg, #ffffff14 0 12px, #ffffff05 12px 24px); }
  .hero__cardtxt { position: absolute; left: clamp(1rem, 1.67vw, 1.5rem); right: clamp(1rem, 1.67vw, 1.5rem); bottom: clamp(1rem, 1.67vw, 1.5rem); display: flex; flex-direction: column; gap: 0.375rem;
    background: var(--k-ink); color: var(--k-paper); border-radius: 16px; padding: 1rem 1.25rem; max-width: clamp(21.25rem, 38.9vw, 35rem); }
  .hero__cardtxt .mono { font-size: 0.75rem; letter-spacing: 0.08em; }
  .hero__cardtxt strong { font-weight: 800; font-stretch: 118%; font-size: clamp(1.625rem, 2.36vw, 2.125rem); letter-spacing: -0.03em; line-height: 1; }
  .hero__cardline { font-size: clamp(0.9375rem, 1.18vw, 1.0625rem); line-height: 1.35; }
  @media (hover: hover) { .hero__card:hover .hero__cardtxt strong { text-decoration: underline; text-underline-offset: 6px; } }

  /* Ruwe staat: Arial-achtige pagina uit 1999. */
  :global(html[data-intro='rough']) { --hero-bg: #e4e4e4; --hero-fg: #111; --hero-muted: #555; --hero-pill-bg: #bbb; --hero-pill-fg: #111; --hero-radius: 0; }
  :global(html[data-intro='rough']) .hero__title { opacity: 0; transform: translateY(14px); }
  :global(html[data-intro='rough']) .hero__rough, :global(html[data-intro='rough']) .note { opacity: 1; }
  :global(html[data-intro='rough']) .hero__sub { opacity: 0.25; transform: translateY(12px); }
  :global(html[data-intro='rough']) .hero__cta { background: transparent; color: #0000ee; border-color: transparent; text-decoration: underline; border-radius: 0; }
  :global(html[data-intro='rough']) .hero__img { filter: grayscale(1) contrast(0.75) blur(3px); }
  .hero__cta { transition: background-color 0.9s var(--ease), color 0.9s var(--ease), border-color 0.9s var(--ease), border-radius 0.9s var(--ease); }
  @media (prefers-reduced-motion: reduce) { .hero, .hero__title, .hero__rough, .note, .hero__sub, .hero__text, .hero__img, .hero__cta, .hero__eyebrow { transition: none; } }
</style>
