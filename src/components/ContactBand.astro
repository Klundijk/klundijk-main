---
// Contactband: op alle pagina's onder de inhoud, boven de footer (ontwerpbord X · Componenten, sectie 05).
import { site, showPlaceholders } from '../data/site';
interface Props { heading?: string; text?: string; cta?: { label: string; href: string }; }
const {
  heading = 'Heb je iets dat digitaal beter kan?',
  text = 'Vertel kort waar je tegenaan loopt of naartoe wilt. Je hoeft nog niet precies te weten welke oplossing je nodig hebt.',
  cta = site.primaryCta,
} = Astro.props;
const { phone, email } = site.contact;
const showContactLine = Boolean(phone || email || showPlaceholders);
---
<section class="band on-field" aria-labelledby="band-h">
  <p class="mono band__kicker">Contact</p>
  <h2 id="band-h" class="band__title">{heading}</h2>
  <p class="band__text">{text}</p>
  <div class="band__actions">
    <a class="btn btn--primary btn--lg" href={cta.href}>{cta.label}</a>
    {showContactLine && (
      <p class="band__line">
        {phone ? <a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a> : showPlaceholders && <span class="placeholder-flag">[telefoonnummer]</span>}
        {(phone || showPlaceholders) && (email || showPlaceholders) && <span aria-hidden="true"> · </span>}
        {email ? <a href={`mailto:${email}`}>{email}</a> : showPlaceholders && <span class="placeholder-flag">[e-mailadres]</span>}
      </p>
    )}
  </div>
</section>
<style>
  .band { background: var(--k-field); color: var(--k-on-field); padding: var(--pad-y) var(--pad-x); display: grid; gap: 1.75rem; justify-items: start; }
  .band__kicker { color: color-mix(in srgb, var(--k-on-field) 78%, transparent); }
  .band__title { font-weight: 800; font-stretch: 118%; font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 0.95; letter-spacing: -0.045em; max-width: 22ch; }
  .band__text { max-width: 38rem; font-size: var(--t-body); }
  .band__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
  .band__line { font-family: var(--f-mono); font-size: 0.9375rem; letter-spacing: 0.04em; }
  .band__line a { display: inline-block; padding-block: 0.5rem; }
</style>
