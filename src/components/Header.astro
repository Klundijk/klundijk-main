---
import MailLink from './MailLink.astro';
import { site, showPlaceholders } from '../data/site';
import Wordmark from './Wordmark.astro';
interface Props { onHero?: boolean; }
const { onHero = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const inSection = (href: string) => path === href || path.startsWith(href + '/');
const isExact = (href: string) => path === href;
const cur = (v: boolean) => (v ? 'page' : undefined);
const hasServices = (href: string) => href === '/wat-we-doen';
const { phone, email } = site.contact;
---
<header class:list={['site-header', { 'on-hero': onHero }]}>
  <a class="brand" href="/" aria-label={`${site.name}, naar de homepage`}><Wordmark class="brand__mark" /></a>

  <!-- Desktop (vanaf 1100 px) -->
  <nav class="nav-desktop" aria-label="Hoofdnavigatie">
    {site.nav.map((i) => <a href={i.href} aria-current={cur(inSection(i.href))}>{i.label}</a>)}
    <a class="cta" href={site.primaryCta.href}>{site.primaryCta.label}</a>
  </nav>

  <!-- Mobiel en tablet (tot 1099 px): zonder JS staan de links als gewone lijst onder de kop; met JS opent "Menu" een volledig scherm. -->
  <button type="button" class="menu-btn" id="menu-open" aria-expanded="false" aria-controls="menu" aria-haspopup="dialog" hidden>
    <span class="menu-btn__icon" aria-hidden="true"></span>Menu
  </button>
  <nav class="nav-fallback" aria-label="Hoofdnavigatie (zonder JavaScript)">
    {site.nav.map((i) => <a href={i.href} aria-current={cur(inSection(i.href))}>{i.label}</a>)}
  </nav>

  <!-- Zwevende menuknop: verschijnt zodra de kop uit beeld is (op elk scherm), opent hetzelfde menu. Alleen met JavaScript. -->
  <button type="button" class="menu-fab" id="menu-fab" aria-expanded="false" aria-controls="menu" aria-haspopup="dialog" hidden>
    <span class="menu-btn__icon" aria-hidden="true"></span>Menu
  </button>

  <dialog id="menu" class="menu" aria-label="Menu" aria-modal="true">
    <div class="menu__bar">
      <span class="menu__brand"><span class="sr-only">{site.name}</span><Wordmark class="brand__mark" /></span>
      <button type="button" class="menu-btn" id="menu-close"><span class="menu-btn__x" aria-hidden="true">×</span>Sluit</button>
    </div>
    <nav class="menu__nav" aria-label="Hoofdnavigatie">
      <ul>
        {site.nav.map((i, n) => (
          <li>
            <a class="menu__main" href={i.href} aria-current={cur(hasServices(i.href) ? isExact(i.href) : inSection(i.href))}>
              <span class="menu__num" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
              <span class="menu__label">{i.label}</span>
            </a>
            {hasServices(i.href) && (
              <ul class="menu__sub">
                {site.services.map((s) => <li><a href={s.href} aria-current={cur(isExact(s.href))}>{s.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="menu__foot">
      <a class="btn btn--primary" href={site.primaryCta.href}>{site.primaryCta.label}</a>
      {(phone || email || showPlaceholders) && (
        <div class="menu__contact">
          {phone ? <a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a> : showPlaceholders && <span class="placeholder-flag">[telefoonnummer]</span>}
          {email ? <MailLink email={email} /> : showPlaceholders && <span class="placeholder-flag">[e-mailadres]</span>}
        </div>
      )}
    </div>
  </dialog>
</header>

<script>
  // Menu als modale dialoog: showModal() zorgt voor focus-trap, inert achtergrond en Escape. Twee openers: de knop in de kop
  // (mobiel/tablet) en de zwevende knop (alle schermen, zodra de kop uit beeld is).
  const dlg = document.getElementById('menu') as HTMLDialogElement | null;
  const open = document.getElementById('menu-open') as HTMLButtonElement | null;
  const fab = document.getElementById('menu-fab') as HTMLButtonElement | null;
  const close = document.getElementById('menu-close') as HTMLButtonElement | null;
  if (dlg && open && close && typeof dlg.showModal === 'function') {
    document.documentElement.classList.add('has-menu');
    open.hidden = false;
    let opener: HTMLButtonElement = open;
    const lock = (on: boolean) => document.documentElement.classList.toggle('menu-open', on);
    const show = (from: HTMLButtonElement) => { opener = from; dlg.showModal(); from.setAttribute('aria-expanded', 'true'); lock(true); close.focus(); };
    const hide = () => { if (dlg.open) dlg.close(); };
    open.addEventListener('click', () => show(open));
    close.addEventListener('click', hide);
    dlg.addEventListener('close', () => {
      open.setAttribute('aria-expanded', 'false'); fab?.setAttribute('aria-expanded', 'false'); lock(false);
      (opener.offsetParent || opener === fab ? opener : open).focus({ preventScroll: true });
    });
    // Klik op een link in het paneel (ook een #anker op dezelfde pagina) sluit het paneel.
    dlg.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a[href]')) hide(); });

    if (fab) {
      fab.hidden = false;
      fab.addEventListener('click', () => show(fab));
      const header = document.querySelector('.site-header');
      if (header && 'IntersectionObserver' in window) {
        // De knop in de kop is zichtbaar zolang de kop in beeld is; daarna neemt de zwevende knop het over.
        new IntersectionObserver(([en]) => fab.classList.toggle('is-visible', !en.isIntersecting), { rootMargin: '-40px 0px 0px 0px' }).observe(header);
      } else {
        addEventListener('scroll', () => fab.classList.toggle('is-visible', scrollY > 240), { passive: true });
      }
    }
  }
</script>

<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 1.25rem var(--pad-x); position: relative; z-index: 5;
    background: var(--k-paper); color: var(--k-ink); }
  .site-header.on-hero { background: var(--hero-bg, var(--k-field)); color: var(--hero-fg, var(--k-on-field)); transition: background 0.9s ease, color 0.9s ease; }
  .brand { display: inline-flex; align-items: center; text-decoration: none; min-height: 44px; }
  .brand, .menu__brand { --mark-h: 1.3rem; }

  /* Zonder JS (en tot 'has-menu' gezet is): links als rij onder de kop. */
  .nav-fallback { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 0 1.5rem; font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.04em; text-transform: uppercase; }
  .nav-fallback a { text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; border-bottom: 2px solid transparent; }
  .nav-fallback a[aria-current='page'] { border-bottom-color: currentColor; }
  :global(html.has-menu) .nav-fallback { display: none; }
  .nav-desktop { display: none; }

  /* Menuknop (gesloten: papier of hero) en sluitknop (veld): ronde rand in de tekstkleur. */
  .menu-btn { min-height: 48px; display: inline-flex; align-items: center; gap: 0.625rem; background: transparent; color: inherit; border: 1.5px solid currentColor;
    border-radius: 999px; padding: 0 1.125rem; font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease; }
  .menu-btn[hidden] { display: none; }
  .menu-btn:hover { background: color-mix(in srgb, currentColor 12%, transparent); }
  .menu-btn__icon { display: inline-block; width: 16px; height: 10px; border-block: 2px solid currentColor; }
  .menu-btn__x { font-size: var(--t-body); line-height: 1; }

  /* Menupaneel: volledig scherm in veldkleur. */
  .menu { position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0;
    background: var(--k-field); color: var(--k-on-field); overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; }
  .menu[open] { display: flex; flex-direction: column; }
  .menu::backdrop { background: var(--k-field); }
  .menu__bar { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem var(--pad-x) 0.75rem; }
  .menu__brand { display: inline-flex; align-items: center; }
  .menu__nav { padding: 0.5rem var(--pad-x) 0; }
  .menu__nav ul { list-style: none; margin: 0; padding: 0; }
  .menu__nav > ul { border-bottom: 1px solid color-mix(in srgb, var(--k-on-field) 35%, transparent); }
  .menu__nav > ul > li { border-top: 1px solid color-mix(in srgb, var(--k-on-field) 35%, transparent); }
  .menu__main { display: flex; align-items: baseline; gap: 1rem; min-height: 60px; padding: 0.625rem 0; text-decoration: none; }
  .menu__num { font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.08em; color: color-mix(in srgb, var(--k-on-field) 78%, transparent); }
  .menu__label { font-weight: 800; font-stretch: 112%; font-size: var(--t-card); line-height: 1.05; letter-spacing: -0.03em; }
  .menu__sub { padding: 0 0 0.75rem 2.25rem !important; }
  .menu__sub a { display: flex; align-items: center; min-height: 44px; font-size: var(--t-small); font-weight: 600; text-decoration: none; }
  .menu__nav a[aria-current='page'] .menu__label, .menu__sub a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .menu__foot { margin-top: auto; padding: 1.25rem var(--pad-x); display: flex; flex-direction: column; gap: 0.875rem; }
  .menu__foot .btn { width: 100%; }
  .menu__contact { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1rem; font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.04em; }
  .menu__contact a { display: inline-flex; align-items: center; min-height: 44px; }
  .menu .btn { --h-bg: var(--k-paper); --h-fg: var(--k-ink); }

  /* Zwevende menuknop: oranje pil rechtsboven, glijdt in zodra de kop uit beeld is. */
  .menu-fab { position: fixed; z-index: 30; top: max(0.75rem, env(safe-area-inset-top)); right: max(var(--pad-x), env(safe-area-inset-right)); min-height: 48px; display: inline-flex; align-items: center; gap: 0.625rem;
    background: var(--k-accent); color: var(--k-ink); border: 0; border-radius: 999px; padding: 0 1.25rem; font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer;
    box-shadow: 0 8px 24px rgb(14 14 18 / 0.22); opacity: 0; visibility: hidden; transform: translateY(-14px) scale(0.96); pointer-events: none;
    transition: opacity 0.3s ease, transform 0.4s var(--ease), visibility 0s linear 0.4s, background-color 0.2s ease, color 0.2s ease; }
  .menu-fab[hidden] { display: none; }
  .menu-fab.is-visible { opacity: 1; visibility: visible; transform: none; pointer-events: auto; transition-delay: 0s; }
  .menu-fab:hover { background: var(--k-ink); color: var(--k-paper); }
  :global(html.menu-open) .menu-fab { opacity: 0; visibility: hidden; }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] { animation: menu-in 250ms var(--ease); }
    @keyframes menu-in { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: none; } }
  }

  @media (min-width: 1100px) {
    .site-header { padding-block: 1.75rem; flex-wrap: nowrap; }
    .brand { --mark-h: 1.6rem; }
    .site-header > .menu-btn, .nav-fallback { display: none !important; }
    .nav-desktop { display: flex; align-items: center; gap: 2.25rem; font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.04em; text-transform: uppercase; }
    .nav-desktop a { text-decoration: none; display: inline-block; padding: 6px 0; border-bottom: 2px solid transparent; }
    .nav-desktop a:hover { border-bottom-color: currentColor; }
    .nav-desktop a[aria-current='page'] { border-bottom-color: currentColor; }
    /* Navigatieknop in de header: kleurt mee met de hero-intro (ruw/verfijnd). */
    .nav-desktop .cta { font-family: var(--f-sans); font-size: var(--t-small); font-weight: 700; letter-spacing: 0; text-transform: none; line-height: 1.2; border: 0; padding: 0.8125rem 1.5rem; border-radius: var(--hero-radius, 999px);
      background: var(--hero-pill-bg, var(--k-accent)); color: var(--hero-pill-fg, var(--k-ink)); transition: all 0.9s var(--ease); }
    .on-hero .cta:hover { background: var(--k-paper); color: var(--k-ink); }
    .site-header:not(.on-hero) .cta:hover { background: var(--k-ink); color: var(--k-paper); }
    .nav-desktop .cta:hover { transition-duration: 0.15s; }
    .menu__bar, .menu__nav, .menu__foot { padding-inline: var(--pad-x); }
    .menu__label { font-size: var(--t-display); }
    .menu__main { min-height: 84px; }
    .menu__sub { display: flex; flex-wrap: wrap; column-gap: 2.5rem; padding-left: 4rem !important; }
    .menu__foot { flex-direction: row; align-items: center; justify-content: space-between; }
    .menu__contact { gap: 2rem; align-items: center; }
    .menu__foot .btn { width: auto; }
  }
</style>
<style is:global>
  html.menu-open { overflow: hidden; }
</style>
