---
// Contactformulier (ontwerpbord X · Componenten, sectie 04). Bedoeld voor een veldkleurig vlak (.on-field).
// Staten: veld (standaard/focus/ingevuld/fout), foutsamenvatting, verzenden, succes, serverfout.
// Validatie bij verzenden, niet bij elke toetsaanslag. Teksten en endpoint staan in src/data/form.ts.
import { form as cfg } from '../data/form';
import { site } from '../data/site';
interface Props { bare?: boolean; submitLabel?: string; }
const { bare = false, submitLabel = cfg.copy.submit } = Astro.props;
const f = cfg.fields;
const privacyHref = site.legal.privacyHref;
// Alleen platte strings naar het clientscript (functies overleven define:vars niet).
const clientCopy = {
  submit: submitLabel,
  busy: cfg.copy.busy,
  title: cfg.copy.successTitle,
  titleNamed: cfg.copy.successTitleNamed,
  success: cfg.copy.success(cfg.responseTime),
  errorBody: cfg.copy.errorBody(site.contact.email),
  errorNotConnected: cfg.copy.errorNotConnected,
};
---
<div class:list={['cform', 'on-field', { 'cform--bare': bare }]} data-cform data-endpoint={cfg.endpoint ?? ''}>
  <form method="post" action={cfg.endpoint ?? undefined} onsubmit={cfg.endpoint ? undefined : 'return false'} aria-labelledby="cform-title" novalidate={false} data-form>
    <h2 id="cform-title" class="sr-only">Contactformulier</h2>

    <div class="summary" data-summary role="alert" tabindex="-1" hidden>
      <p class="summary__title"><span class="icon" aria-hidden="true">!</span>{cfg.copy.summaryTitle}</p>
      <ul data-summary-list></ul>
    </div>

    <div class="grid2">
      <div class="field" data-field="naam">
        <label for="f-naam">{f.naam.label}</label>
        <input id="f-naam" name="naam" type="text" autocomplete="name" required data-empty={f.naam.empty} data-summary-text={f.naam.summary} />
        <p class="err" id="f-naam-err" data-err hidden><span class="icon" aria-hidden="true">!</span><span data-err-text></span></p>
      </div>
      <div class="field" data-field="bedrijf">
        <label for="f-bedrijf">{f.bedrijf.label} <span class="opt">{f.bedrijf.optional}</span></label>
        <input id="f-bedrijf" name="bedrijf" type="text" autocomplete="organization" />
      </div>
      <div class="field field--wide" data-field="email">
        <label for="f-email">{f.email.label}</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required data-empty={f.email.empty} data-invalid={f.email.invalid} data-summary-text={f.email.summary} />
        <p class="err" id="f-email-err" data-err hidden><span class="icon" aria-hidden="true">!</span><span data-err-text></span></p>
      </div>
      <div class="field field--wide" data-field="vraagstuk">
        <label for="f-vraag">{f.vraagstuk.label}</label>
        <textarea id="f-vraag" name="vraagstuk" rows="3" required data-empty={f.vraagstuk.empty} data-summary-text={f.vraagstuk.summary}></textarea>
        <p class="err" id="f-vraag-err" data-err hidden><span class="icon" aria-hidden="true">!</span><span data-err-text></span></p>
      </div>
    </div>

    <!-- Spamval: verborgen veld buiten beeld en buiten de tabvolgorde; serverkant controleert of het leeg is. -->
    <div class="hp" aria-hidden="true"><label>Laat dit veld leeg <input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>

    <div class="servererr" data-servererr role="alert" tabindex="-1" hidden>
      <p class="servererr__title"><span class="icon" aria-hidden="true">!</span>{cfg.copy.errorTitle}</p>
      <p data-servererr-text></p>
      <button type="button" class="btn btn--primary btn--md" data-retry>{cfg.copy.retry}</button>
    </div>

    <div class="submit">
      <button type="submit" class="btn btn--primary btn--lg" data-submit><span data-dots aria-hidden="true" hidden>···</span><span data-submit-label>{submitLabel}</span></button>
    </div>

    <p class="privacy">
      {privacyHref
        ? <>{cfg.copy.privacy} <a href={privacyHref}>{cfg.copy.privacyLink}</a>.</>
        : import.meta.env.DEV && <span class="placeholder-flag">[privacytekst en -link volgen]</span>}
    </p>
  </form>

  <div class="success" data-success hidden>
    <p class="mono success__kicker">{cfg.copy.successKicker}</p>
    <h2 class="success__title" tabindex="-1" data-success-title></h2>
    <p class="success__text" data-success-text></p>
    <a class="link-strong" href="/">{cfg.copy.successBack}</a>
  </div>
</div>

<script define:vars={{ copy: clientCopy }}>
  (function () {
    var root = document.querySelector('[data-cform]');
    if (!root) return;
    var form = root.querySelector('[data-form]');
    var summary = root.querySelector('[data-summary]');
    var summaryList = root.querySelector('[data-summary-list]');
    var serverErr = root.querySelector('[data-servererr]');
    var serverErrText = root.querySelector('[data-servererr-text]');
    var submit = root.querySelector('[data-submit]');
    var dots = root.querySelector('[data-dots]');
    var label = root.querySelector('[data-submit-label]');
    var success = root.querySelector('[data-success]');
    var busy = false;
    form.noValidate = true; // eigen validatie en meldingen; zonder JS blijft de browservalidatie werken
    var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    function fieldOf(input) { return input.closest('[data-field]'); }
    function setError(input, msg) {
      var wrap = fieldOf(input), err = wrap.querySelector('[data-err]');
      wrap.classList.add('is-invalid');
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', err.id);
      err.querySelector('[data-err-text]').textContent = msg;
      err.hidden = false;
    }
    function clearError(input) {
      var wrap = fieldOf(input), err = wrap.querySelector('[data-err]');
      wrap.classList.remove('is-invalid');
      input.removeAttribute('aria-invalid');
      input.removeAttribute('aria-describedby');
      if (err) err.hidden = true;
    }
    function check(input) {
      var v = input.value.trim();
      if (!input.required) return null;
      if (!v) return input.dataset.empty;
      if (input.type === 'email' && !EMAIL.test(v)) return input.dataset.invalid || input.dataset.empty;
      return null;
    }
    function renderSummary(items) {
      summaryList.textContent = '';
      items.forEach(function (it) {
        var li = document.createElement('li'), a = document.createElement('a');
        a.href = '#' + it.input.id;
        a.textContent = it.labelText + ': ' + it.summary;
        a.addEventListener('click', function (e) { e.preventDefault(); it.input.focus(); });
        li.appendChild(a); summaryList.appendChild(li);
      });
      summary.hidden = items.length === 0;
    }
    function labelOf(input) { return fieldOf(input).querySelector('label').firstChild.textContent.trim(); }
    function validate() {
      var items = [];
      form.querySelectorAll('input[required], textarea[required]').forEach(function (input) {
        var msg = check(input);
        if (msg) { setError(input, msg); items.push({ input: input, labelText: labelOf(input), summary: input.dataset.summaryText }); }
        else clearError(input);
      });
      renderSummary(items);
      return items;
    }
    // Na een eerste mislukte poging: een veld dat weer klopt verliest zijn melding direct.
    form.addEventListener('input', function (e) {
      var input = e.target;
      if (!input.matches || !input.matches('[aria-invalid="true"]')) return;
      if (!check(input)) {
        clearError(input);
        var rest = [];
        form.querySelectorAll('[aria-invalid="true"]').forEach(function (i) { rest.push({ input: i, labelText: labelOf(i), summary: i.dataset.summaryText }); });
        renderSummary(rest);
      }
    });
    function setBusy(on) {
      busy = on;
      submit.toggleAttribute('aria-busy', on);
      if (on) { submit.setAttribute('aria-busy', 'true'); submit.setAttribute('aria-disabled', 'true'); } else { submit.removeAttribute('aria-busy'); submit.removeAttribute('aria-disabled'); }
      dots.hidden = !on;
      label.textContent = on ? copy.busy : copy.submit;
    }
    function showServerError(text) {
      serverErrText.textContent = text;
      serverErr.hidden = false;
      serverErr.focus();
    }
    function showSuccess(name) {
      var title = root.querySelector('[data-success-title]');
      title.textContent = name ? copy.titleNamed.replace('{naam}', name) : copy.title;
      root.querySelector('[data-success-text]').textContent = copy.success;
      form.hidden = true; success.hidden = false; title.focus();
    }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (busy) return; // geen dubbele verzending
      serverErr.hidden = true;
      var errors = validate();
      if (errors.length) { summary.focus(); return; }
      var endpoint = root.dataset.endpoint || '';
      if (!endpoint) { showServerError(copy.errorNotConnected); return; }
      setBusy(true);
      var data = new FormData(form);
      fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); setBusy(false); showSuccess(String(data.get('naam') || '').trim().split(/\s+/)[0]); })
        .catch(function () { setBusy(false); showServerError(copy.errorBody); });
    });
    root.querySelector('[data-retry]').addEventListener('click', function () { form.requestSubmit(); });
  })();
</script>

<style>
  .cform { background: var(--k-field); color: var(--k-on-field); border-radius: 20px; padding: clamp(1.25rem, 3vw, 2.25rem); }
  form { display: grid; gap: 2rem; max-width: none; }
  .cform--bare { background: transparent; border-radius: 0; padding: 0; }
  .cform--bare .grid2 { grid-template-columns: 1fr !important; }
  .grid2 { display: grid; gap: 2rem 2.5rem; }
  @media (min-width: 768px) { .grid2 { grid-template-columns: 1fr 1fr; } .field--wide { grid-column: 1 / -1; } }
  .field { display: flex; flex-direction: column; gap: 0.375rem; }
  label { font-family: var(--f-mono); font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 400; display: block; }
  .opt { text-transform: none; letter-spacing: 0; color: color-mix(in srgb, var(--k-on-field) 78%, transparent); }
  /* Veld: alleen een onderrand, 52 px hoog. Focus = de globale tweekleurige ring. */
  input, textarea { appearance: none; background: transparent; color: inherit; border: 0; border-bottom: 2px solid var(--k-on-field); border-radius: 0; padding: 0; min-height: 52px;
    font: inherit; font-size: 1.25rem; line-height: 1.4; width: 100%; }
  textarea { padding-block: 0.5rem; min-height: 96px; resize: vertical; }
  .is-invalid input, .is-invalid textarea { border-bottom: 4px solid var(--k-error); }
  .err, .servererr__title, .summary__title { display: flex; gap: 0.625rem; align-items: flex-start; color: var(--k-error); font-size: 1rem; font-weight: 500; line-height: 1.4; margin: 0; max-width: none; }
  .icon { flex: none; width: 22px; height: 22px; border: 2px solid currentColor; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.875rem; line-height: 1; }
  .summary, .servererr { border: 2px solid var(--k-error); border-radius: 20px; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .summary[hidden], .servererr[hidden], .err[hidden], .success[hidden], form[hidden] { display: none; }
  .summary__title, .servererr__title { font-weight: 700; font-size: 1.125rem; }
  .summary ul { margin: 0; padding-left: 1.25rem; line-height: 1.6; }
  .summary a { color: var(--k-on-field); }
  .servererr p { max-width: 34rem; margin: 0; }
  .servererr .btn { align-self: flex-start; }
  .submit { display: flex; }
  [data-dots] { letter-spacing: 2px; }
  .privacy { font-size: 0.875rem; line-height: 1.5; color: color-mix(in srgb, var(--k-on-field) 78%, transparent); max-width: none; margin: 0; }
  .privacy a { color: var(--k-on-field); }
  .hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  /* Succes: het formulier wordt vervangen door een papieren kaart. */
  .success { background: var(--k-paper); color: var(--k-ink); border-radius: 24px; padding: 2rem; display: flex; flex-direction: column; gap: 0.875rem; align-items: flex-start; }
  .success__kicker { color: var(--k-muted); margin: 0; }
  .success__title { font-weight: 800; font-stretch: 118%; font-size: clamp(1.75rem, 3vw, 2.25rem); line-height: 1.02; letter-spacing: -0.03em; margin: 0; }
  .success__text { font-size: 1.125rem; line-height: 1.5; max-width: 32.5rem; margin: 0; }
  @media (prefers-reduced-motion: reduce) { [data-dots] { animation: none; } }
</style>
