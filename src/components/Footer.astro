---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap">
    <p><strong>{site.name}</strong> · {site.contact.location}</p>
    <p class="muted">{site.contact.email}</p>
    <p class="muted">Bedrijfsgegevens (KvK, btw, privacyverklaring) volgen.</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--color-line); padding-block: var(--space-5); margin-top: var(--space-6); }
</style>
