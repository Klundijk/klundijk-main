---
import { dims } from '../../lib/images';
// Overzicht "Wat we doen" (bord X · Wat we doen, 1440 en 390). Commerce uitgelicht, drie rijen, vraagstukken, werkwijze.
import Base from '../../layouts/Base.astro';
import { getWorkItems } from '../../lib/content';
import { showPlaceholders } from '../../data/site';
import { DIENSTEN, dienstHref, dienstLabels } from '../../data/diensten';
import { overzicht as o } from '../../data/overzicht';
import { principlesHeading, steps, werkwijzeHref } from '../../data/werkwijze';

const work = await getWorkItems();
const commerceImg = work.find((w) => w.id === 'rootboxes')?.data.cardImage;
const commerce = DIENSTEN[0];
const rows = DIENSTEN.slice(1).map((d, i) => {
  const r = o.rows[d.id];
  const ex = r ? work.find((w) => w.id === r.example && w.data.services.includes(d.id)) : undefined;
  return { d, n: String(i + 2).padStart(2, '0'), r, example: ex?.data.title };
});
const num = (n: number) => String(n + 1).padStart(2, '0');
---
<Base title="Wat we doen" description="Merk, websites, webshops en slimme digitale processen: waarvoor je Klundijk inschakelt." heroHeader>
  <section class="hero on-field" aria-labelledby="wwd-title">
    <p class="mono kicker">{o.eyebrow}</p>
    <h1 id="wwd-title" class="hero__title">{o.title.map((t) => <span class="nb">{t} </span>)}</h1>
    <p class="hero__lead">{o.lead}</p>
  </section>

  <section class="commerce on-field" aria-labelledby="commerce-h">
    <div class="commerce__img" style={`--bg:${work.find((w) => w.id === 'rootboxes')?.data.cardColor ?? '#DAD5CB'}`}>
      {commerceImg && <img src={commerceImg.src} width={dims(commerceImg.src).width} height={dims(commerceImg.src).height} alt={commerceImg.alt} loading="lazy" decoding="async" style={commerceImg.position ? `object-position:${commerceImg.position}` : undefined} />}
    </div>
    <div class="commerce__text">
      <p class="commerce__meta"><span class="mono kicker">01</span><span class="pill pill--light mono">{o.commerce.badge}</span></p>
      <h2 id="commerce-h" class="commerce__title">{commerce.label}</h2>
      <p class="commerce__lead">{o.commerce.lead}</p>
      <ul class="topics">
        {o.commerce.topics.map((t) => <li>{t}</li>)}
      </ul>
      <p class="commerce__cta"><a class="btn btn--primary btn--lg" href={dienstHref(commerce.id)}>{o.commerce.cta}</a></p>
    </div>
  </section>

  <section class="rows wrap-full" aria-label="Overige terreinen">
    <ol class="rowlist">
      {rows.map(({ d, n, r, example }) => (
        <li class="drow">
          <span class="mono muted drow__n">{n}</span>
          <h3 class="drow__t">{d.label}</h3>
          <div class="drow__body">
            {r && <p class="drow__p">{r.text}</p>}
            {r && <ul class="pills">{r.pills.map((p) => <li class="pill mono">{p}</li>)}</ul>}
          </div>
          <div class="drow__side">
            {example && <p class="mono muted drow__ex">Voorbeeld: {example}</p>}
            <a class="link-strong" href={dienstHref(d.id)}>Meer over {d.label.toLowerCase()}</a>
          </div>
        </li>
      ))}
    </ol>
    {showPlaceholders && <p class="flag mono">Concepttekst · SEO &amp; content beoordeelt</p>}
  </section>

  <section class="vraag wrap-full" aria-labelledby="vraag-h">
    <p class="mono muted">{o.vraagstukken.kicker}</p>
    <h2 id="vraag-h" class="h2">{o.vraagstukken.title}</h2>
    <nav aria-label="Kies je vraagstuk">
      <ul class="vlist">
        {o.vraagstukken.items.map((v) => (
          <li>
            <a class="vlink" href={dienstHref(v.dienst)}>
              <span class="vlink__t"><span class="vlink__q">{v.text}</span><span class="mono muted">{dienstLabels[v.dienst]}</span></span>
              <span class="vlink__a" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <section class="how wrap-full" aria-labelledby="how-h">
    <p class="mono muted">{o.werkwijze.kicker}</p>
    <h2 id="how-h" class="h2">{principlesHeading}</h2>
    <ol class="steps">
      {steps.map((t, i) => <li><span class="mono muted">{num(i)}</span><span class="step__t">{t}</span></li>)}
    </ol>
    <a class="link-strong" href={werkwijzeHref}>Meer over onze werkwijze</a>
  </section>
</Base>

<style>
  .wrap-full { padding-inline: var(--pad-x); }
  .mono { font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.08em; text-transform: uppercase; margin: 0; }
  .muted { color: var(--k-muted); }
  .kicker { color: color-mix(in srgb, var(--k-on-field) 78%, transparent); }
  .pill { display: inline-block; border: 1px solid var(--k-ink); border-radius: 999px; padding: 0.375rem 0.875rem; font-size: 0.75rem; letter-spacing: 0.04em; color: var(--k-ink); }
  .pill--light { border-color: var(--k-on-field); color: var(--k-on-field); }
  .flag { align-self: flex-start; border: 1px solid var(--k-ink); border-radius: 999px; padding: 0.375rem 0.875rem; font-size: 0.75rem; letter-spacing: 0.04em; }
  .h2 { margin: 0; font-weight: 800; font-stretch: 118%; font-size: var(--t-display); line-height: 1.06; letter-spacing: -0.04em; text-wrap: balance; }

  @media (min-width: 768px) { .h2 { line-height: 0.98; } }
  /* Hero op veldkleur (header is on-hero) */
  .hero { background: var(--k-field); color: var(--k-on-field); padding: 1.5rem var(--pad-x) 3.5rem; display: flex; flex-direction: column; gap: 1.375rem; }
  .hero__title { margin: 0; font-weight: 800; font-stretch: 118%; font-size: clamp(1.875rem, 10.2vw, 2.5rem); line-height: 0.94; letter-spacing: -0.045em; max-width: 18ch; overflow-wrap: anywhere; }
  @media (min-width: 768px) { .nb { display: inline-block; } .hero__title { font-size: clamp(2.5rem, 6.4vw, 5.75rem); } }
  .hero__lead { margin: 0; max-width: 40rem; font-size: clamp(1.125rem, 1.67vw, 1.5rem); line-height: 1.5; }

  /* Uitgelicht: Webshops & commerce */
  .commerce { background: var(--k-field); color: var(--k-on-field); padding: 0 var(--pad-x) var(--pad-y); display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: center; }
  .commerce__img { position: relative; overflow: hidden; height: 15rem; border-radius: 24px; background: var(--bg); }
  .commerce__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .commerce__text { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }
  .commerce__meta { margin: 0; display: flex; align-items: center; gap: 0.75rem; }
  .commerce__title { margin: 0; font-weight: 800; font-stretch: 118%; font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 1.04; letter-spacing: -0.04em; overflow-wrap: anywhere; }
  @media (min-width: 768px) { .commerce__title { line-height: 0.96; } }
  .commerce__lead { margin: 0; max-width: 35rem; font-size: clamp(1.0625rem, 1.4vw, 1.25rem); line-height: 1.5; }
  .topics { list-style: none; margin: 0; padding: 0; max-width: 35rem; border-bottom: 1px solid rgb(255 255 255 / 0.35); }
  .topics li { border-top: 1px solid rgb(255 255 255 / 0.35); padding: 0.625rem 0; font-size: 1.125rem; font-weight: 600; }
  .commerce__cta { margin: 0.25rem 0 0; }

  /* Rijen: nummer, titel, tekst + pills, voorbeeld + link */
  .rows { background: var(--k-paper); padding-block: 3.5rem 2.5rem; display: flex; flex-direction: column; gap: 2.5rem; }
  .rowlist { list-style: none; margin: 0; padding: 0; border-bottom: 2px solid var(--k-ink); }
  .drow { border-top: 2px solid var(--k-ink); padding: 1.5rem 0 0.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .drow__t { margin: 0; font-weight: 800; font-stretch: 112%; font-size: 2rem; line-height: 1.02; letter-spacing: -0.03em; overflow-wrap: anywhere; }
  .drow__body { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }
  .drow__p { margin: 0; color: var(--k-muted); font-size: 1.0625rem; line-height: 1.5; max-width: 45rem; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .drow__side { display: flex; flex-direction: column; gap: 0.25rem; align-items: flex-start; }
  .drow__ex { text-transform: uppercase; letter-spacing: 0.06em; }

  .vraag { background: var(--k-paper); padding-block: 3.5rem; display: flex; flex-direction: column; gap: 2rem; }
  .vlist { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--k-ink); }
  .vlist li { border-top: 1px solid var(--k-ink); }
  .vlink { min-height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; text-decoration: none; padding-block: 0.75rem; }
  .vlink__t { display: flex; flex-direction: column; gap: 0.25rem; }
  .vlink__q { font-weight: 700; font-size: 1.125rem; line-height: 1.25; max-width: 47rem; }
  .vlink__a { font-size: 1.75rem; transition: transform 0.2s var(--ease); }

  .how { background: var(--k-paper); border-top: 1px solid var(--k-ink); padding-block: 3.5rem var(--pad-y); display: flex; flex-direction: column; gap: 2rem; align-items: flex-start; }
  .how .h2 { max-width: 20ch; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; align-self: stretch; }
  .steps li { display: flex; flex-direction: column; gap: 0.5rem; border-top: 1px solid var(--k-ink); padding-top: 0.75rem; min-width: 0; }
  .step__t { font-weight: 800; font-stretch: 112%; font-size: 1.375rem; letter-spacing: -0.02em; line-height: 1.1; }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .vlink:hover .vlink__a { transform: translateX(4px); } }
  @media (min-width: 768px) {
    .commerce__img { height: 22rem; }
    .drow__p { font-size: 1.125rem; }
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
    .step__t { font-size: 1.625rem; }
    .vlink__q { font-size: 1.25rem; }
  }
  @media (min-width: 1100px) {
    .hero { padding-bottom: var(--pad-y); }
    .commerce { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
    .commerce__img { grid-column: 1 / span 5; height: 30rem; }
    .commerce__text { grid-column: 7 / span 6; }
    .rows { padding-block: var(--pad-y) 4.5rem; }
    .rowlist { display: flex; flex-direction: column; gap: 1.5rem; border-bottom: 2px solid var(--k-ink); }
    .drow { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: start; padding: 2rem 0 2.5rem; }
    .drow__n { grid-column: 1 / span 1; }
    .drow__t { grid-column: 2 / span 4; font-stretch: 118%; font-size: 2.5rem; }
    .drow__body { grid-column: 6 / span 4; }
    .drow__side { grid-column: 10 / span 3; gap: 0.75rem; }
    .vraag { padding-block: 4.5rem var(--pad-y); }
    .steps { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
</style>
