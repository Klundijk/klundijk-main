---
// Privacyverklaring. Tekst en feiten staan in src/data/privacy.ts (concept tot Levi ze bevestigt).
import Base from '../layouts/Base.astro';
import { privacy as p } from '../data/privacy';
// Cloudflare (voor de host) verhult e-mailadressen in lopende tekst; email_off houdt ze leesbaar in de ruwe HTML.
const safe = (t: string) => t.replaceAll('info@klundijk.com', '<!--email_off-->info@klundijk.com<!--/email_off-->');
---
<Base title={p.seo.title} description={p.seo.description} contactBand={false} heroHeader>
  <section class="hero on-field" aria-labelledby="privacy-title">
    <p class="mono kicker">Privacy</p>
    <h1 id="privacy-title" class="title">{p.title}</h1>
    <p class="lead">{p.lead}</p>
    <p class="mono updated">Laatst bijgewerkt: {p.updated}</p>
  </section>

  <article class="doc">
    {p.sections.map((s) => (
      <section class="sec" aria-labelledby={`h-${s.id}`}>
        <h2 id={`h-${s.id}`} class="sec__t">{s.title}</h2>
        <div class="sec__b">
          {s.paragraphs.map((t) => <p set:html={safe(t)} />)}
          {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
          {s.after && <p set:html={safe(s.after)} />}
        </div>
      </section>
    ))}
  </article>
</Base>

<style>
  .mono { font-family: var(--f-mono); letter-spacing: 0.04em; }
  .hero { background: var(--k-field); color: var(--k-on-field); padding: 1.5rem var(--pad-x) var(--pad-y); display: flex; flex-direction: column; gap: 1.375rem; }
  .kicker { margin: 0; font-size: var(--t-mono); letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--k-on-field) 78%, transparent); }
  .title { margin: 0; font-weight: 800; font-stretch: 112%; font-size: var(--t-h1); line-height: 1; letter-spacing: -0.04em; text-wrap: balance; max-width: 16ch; }
  .lead { margin: 0; max-width: 36rem; font-size: var(--t-lead); line-height: 1.5; }
  .updated { margin: 0; font-size: var(--t-mono); color: color-mix(in srgb, var(--k-on-field) 78%, transparent); }

  .doc { padding: var(--pad-y) var(--pad-x); display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 1fr); }
  .sec { display: grid; gap: 0.875rem; grid-template-columns: minmax(0, 1fr); border-top: 2px solid var(--k-ink); padding-top: 1rem; }
  .sec__t { margin: 0; font-weight: 800; font-stretch: 112%; font-size: var(--t-lead); line-height: 1.08; letter-spacing: -0.03em; }
  .sec__b { display: flex; flex-direction: column; gap: 0.875rem; max-width: 40rem; font-size: var(--t-small); line-height: 1.6; min-width: 0; }
  .sec__b p { margin: 0; }
  .sec__b ul { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  @media (min-width: 1100px) {
    .doc { gap: 3rem; }
    .sec { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
    .sec__t { grid-column: 1 / span 4; font-size: var(--t-card); }
    .sec__b { grid-column: 5 / span 7; }
  }
</style>
