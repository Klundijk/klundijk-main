---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getPublishedCases } from '../../lib/content';
const cases = await getPublishedCases();
---
<Base title="Werk" description="Geselecteerd werk van Klundijk.">
  <section class="section wrap">
    <h1>Werk</h1>
    {cases.length ? (
      <div class="grid grid--2">{cases.map((c) => <CaseCard entry={c} />)}</div>
    ) : (
      <p class="muted">Cases volgen zodra ze toonbaar zijn.</p>
    )}
  </section>
</Base>
