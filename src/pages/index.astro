---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Situations from '../components/home/Situations.astro';
import Werk from '../components/home/Werk.astro';
import WatWeDoen from '../components/home/WatWeDoen.astro';
import Case from '../components/home/Case.astro';
import Proces from '../components/home/Proces.astro';
import Over from '../components/home/Over.astro';
import Klanten from '../components/home/Klanten.astro';
import Contact from '../components/home/Contact.astro';
import { site } from '../data/site';
---
<Base description={site.description} heroHeader contactBand={false}>
  <script is:inline slot="head">
    (function(){try{
      var r=document.documentElement, reduce=matchMedia('(prefers-reduced-motion: reduce)').matches, seen=sessionStorage.getItem('kl-intro');
      if(!reduce&&!seen){r.dataset.intro='rough';r.dataset.introAuto='1';sessionStorage.setItem('kl-intro','1');}
      else r.dataset.intro='refined';
    }catch(e){document.documentElement.dataset.intro='refined';}})();
  </script>
  <noscript slot="head"><style>.wpanel[hidden] { display: block !important; }</style></noscript>
  <Hero />
  <Werk />
  <Marquee />
  <Situations />
  <WatWeDoen />
  <Case />
  <Proces />
  <Over />
  <Klanten />
  <Contact />
</Base>
