---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Situations from '../components/home/Situations.astro';
import Werk from '../components/home/Werk.astro';
import WatWeDoen from '../components/home/WatWeDoen.astro';
import Case from '../components/home/Case.astro';
import Proces from '../components/home/Proces.astro';
import Over from '../components/home/Over.astro';
import Klanten from '../components/home/Klanten.astro';
import Contact from '../components/home/Contact.astro';
import { site } from '../data/site';
---
<Base description={site.description} heroHeader contactBand={false}>
  <noscript slot="head"><style>.wpanel:not([data-open]) { grid-template-rows: 1fr !important; visibility: visible !important; } .wpanel:not([data-open]) .wcard { opacity: 1 !important; transform: none !important; }</style></noscript>
  <Hero />
  <Werk />
  <Marquee />
  <Situations />
  <WatWeDoen />
  <Case />
  <Proces />
  <Over />
  <Klanten />
  <Contact />
</Base>
