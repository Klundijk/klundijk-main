---
// 404 (bord X · 404, 1440 en 390): blauw veld, decoratieve 404, snelle links. Concepttekst: SEO & content beoordeelt.
// Status 404 en noindex komen van de host (Vercel serveert 404.html met status 404); meta noindex staat hier ook.
import Base from '../layouts/Base.astro';
import { site, showPlaceholders } from '../data/site';
import { DIENSTEN, dienstHref } from '../data/diensten';

const taglines: Record<string, string> = {
  'webshops-commerce': 'Van advies tot webshop',
  'websites-digitale-ervaringen': 'Sites die werken voor je klant',
  'groei-slimme-processen': 'Minder handwerk, meer overzicht',
  'merk-identiteit': 'Logo, huisstijl, uitstraling',
};
const links = [
  ...DIENSTEN.map((d) => ({ label: d.label, sub: taglines[d.id], href: dienstHref(d.id) })),
  { label: 'Ons werk', sub: 'Projecten en cases', href: '/werk' },
  { label: 'Contact', sub: 'Praat direct met Levi', href: '/contact' },
];
const { phone, email } = site.contact;
---
<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer). Ga terug naar de homepage of bekijk ons werk." noindex heroHeader contactBand={false}>
  <section class="hero on-field" aria-labelledby="nf-title">
    <div class="hero__main">
      <div class="big" aria-hidden="true"></div>
      <p class="mono kicker">Fout 404 · Pagina niet gevonden</p>
      <h1 id="nf-title" class="title">Deze pagina bestaat niet. Dat kan <span class="beter">beter.</span></h1>
      <p class="lead">Het adres klopt niet of de pagina is verplaatst. Hieronder staan de plekken waar je wel iets vindt.</p>
      <p class="actions">
        <a class="btn btn--primary btn--lg" href="/">Naar de homepage</a>
        <a class="btn btn--ghost btn--lg" href="/werk">Bekijk ons werk</a>
      </p>
    </div>
    <nav class="quick" aria-label="Waar wil je heen?">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}>
              <span class="quick__t"><span class="quick__l">{l.label}</span><span class="quick__s">{l.sub}</span></span>
              <span aria-hidden="true" class="quick__a">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <section class="ask wrap-full" aria-labelledby="ask-h">
    <div class="ask__t">
      <p class="mono muted">Zocht je iets anders?</p>
      <h2 id="ask-h" class="ask__h">Vertel Levi wat je zocht.</h2>
    </div>
    <div class="ask__links">
      {email ? <a class="mono" href={`mailto:${email}`}>{email}</a> : showPlaceholders && <span class="placeholder-flag">[e-mailadres]</span>}
      {phone ? <a class="mono" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a> : showPlaceholders && <span class="placeholder-flag">[telefoonnummer]</span>}
    </div>
    {showPlaceholders && <p class="flag mono">Concepttekst · SEO &amp; content beoordeelt</p>}
  </section>
</Base>

<style>
  .wrap-full { padding-inline: var(--pad-x); }
  .mono { font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.08em; text-transform: uppercase; margin: 0; }
  .muted { color: var(--k-muted); }
  .kicker { color: color-mix(in srgb, var(--k-on-field) 78%, transparent); }

  .hero { background: var(--k-field); color: var(--k-on-field); padding: 1.5rem var(--pad-x) var(--pad-y); display: flex; flex-direction: column; gap: 2.5rem; }
  .hero__main { display: flex; flex-direction: column; gap: 1.375rem; min-width: 0; }
  .big { font-weight: 800; font-stretch: 125%; font-size: clamp(8.75rem, 26.4vw, 23.75rem); line-height: 0.8; letter-spacing: -0.06em; color: rgb(255 255 255 / 0.16); margin: 0 0 0.5rem -0.25rem; user-select: none; }
  /* Decoratief: via ::before, zodat het geen leesbare tekst of contrastcontrole is. */
  .big::before { content: '404'; content: '404' / ''; }
  .title { margin: 0; font-weight: 800; font-stretch: 118%; font-size: clamp(2.5rem, 5.83vw, 5.25rem); line-height: 0.95; letter-spacing: -0.045em; max-width: 16ch; text-wrap: balance; }
  .beter { font-family: var(--f-serif); font-style: italic; font-weight: 400; font-stretch: 100%; font-size: 1.12em; letter-spacing: -0.01em; color: var(--k-accent-text); }
  .lead { margin: 0; max-width: 35rem; font-size: clamp(1.125rem, 1.53vw, 1.375rem); line-height: 1.5; }
  .actions { margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }

  .quick ul { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgb(255 255 255 / 0.35); }
  .quick li { border-top: 1px solid rgb(255 255 255 / 0.35); }
  .quick a { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; text-decoration: none; color: inherit; padding-block: 0.5rem; }
  .quick__t { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; }
  .quick__l { font-weight: 800; font-stretch: 112%; font-size: 1.375rem; letter-spacing: -0.03em; line-height: 1.1; overflow-wrap: anywhere; }
  .quick__s { font-size: 0.9375rem; color: rgb(255 255 255 / 0.78); }
  .quick__a { font-size: 1.75rem; transition: transform 0.2s var(--ease); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .quick a:hover .quick__a { transform: translateX(4px); } }

  .ask { background: var(--k-paper); padding-block: 3rem; display: flex; flex-direction: column; gap: 2rem; align-items: flex-start; }
  .ask__t { display: flex; flex-direction: column; gap: 0.75rem; }
  .ask__h { margin: 0; font-weight: 800; font-stretch: 112%; font-size: 1.75rem; line-height: 1.02; letter-spacing: -0.03em; }
  .ask__links { display: flex; flex-direction: column; gap: 0.25rem; }
  .ask__links a { font-size: 1rem; letter-spacing: 0.04em; text-transform: none; min-height: 44px; display: inline-flex; align-items: center; }
  .flag { border: 1px solid var(--k-ink); border-radius: 999px; padding: 0.375rem 0.875rem; font-size: 0.75rem; letter-spacing: 0.04em; }

  @media (min-width: 768px) {
    .quick a { min-height: 72px; }
    .quick__l { font-size: 1.875rem; font-stretch: 118%; }
    .ask__h { font-size: 2.75rem; font-stretch: 118%; }
  }
  @media (min-width: 1100px) {
    .hero { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: end; padding-bottom: var(--pad-y); }
    .hero__main { grid-column: 1 / span 7; }
    .quick { grid-column: 9 / span 4; }
    .ask { flex-direction: row; align-items: center; justify-content: space-between; padding-block: 4.5rem; }
  }
</style>
